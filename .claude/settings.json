{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/test-first-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking test-first order"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-tools/worktree-setup.mjs\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-tools/worktree-setup.mjs\" create",
            "timeout": 600,
            "statusMessage": "Preparing the agent worktree"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-tools/worktree-setup.mjs\" remove",
            "timeout": 120,
            "statusMessage": "Releasing the agent worktree"
          }
        ]
      }
    ]
  }
}
