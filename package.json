{
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests.js scripts/agent-tools/*.test.mjs",
    "test:agent-tools": "node --test scripts/agent-tools/*.test.mjs",
    "agent:rendered-evidence": "node scripts/agent-tools/rendered-evidence.mjs",
    "agent:record-test-run": "node scripts/agent-tools/record-run.mjs",
    "agent:host-coordination": "node scripts/agent-tools/coordination.mjs",
    "agent:preflight": "node scripts/agent-tools/preflight.mjs",
    "agent:browser-audit": "node scripts/agent-tools/browser-audit.mjs",
    "agent:ci-monitor": "node scripts/agent-tools/ci-monitor.mjs",
    "agent:pr-body-update": "node scripts/agent-tools/pr-body-update.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-chain-scanner-data-safety \"node --test --test-name-pattern='Firestore rules:' tests.js\"",
    "test:compatibility": "firebase emulators:exec --only firestore --project demo-backward-compatibility \"node scripts/backward-compatibility.mjs\"",
    "release:install-hook": "node scripts/install-release-hook.mjs",
    "release:record": "node scripts/release-evidence.mjs record",
    "release:verify": "node scripts/release-evidence.mjs verify",
    "release:publish": "node scripts/release-evidence.mjs publish"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.30.2"
  }
}
